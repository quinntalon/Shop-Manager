# Copy to .env for local development. Never commit real secrets — .env is gitignored.

# Database — required. Use a PostgreSQL connection string.
# For Vercel: add this in the Vercel dashboard under Environment Variables.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# App (local dev only — not needed on Vercel)
PORT=5000
API_PORT=3001
BASE_PATH=/

# Cloudinary (image uploads) — from your Cloudinary dashboard's API Keys page
# Optional: image uploads are disabled if these are not set.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
