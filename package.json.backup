{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build shopDesk/tsconfig.json",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./shopDesk/frontend\" --filter \"./shopDesk/backend\" --filter \"./shopDesk/scripts\" --if-present run typecheck",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:push-force": "pnpm --filter @workspace/db run push-force",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "dev:api": "PORT=3001 pnpm --filter @workspace/api-server run dev",
    "dev:shop": "pnpm --filter @workspace/shop run dev",
    "dev:storefront": "PORT=5001 pnpm --filter @workspace/storefront run dev"
  },
  "private": true,
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist",
    "start": "node dist/index.mjs"
  }
}
  }
